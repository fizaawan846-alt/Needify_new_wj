# =====================================================
# NEEDIFY ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================

# Database Configuration (XAMPP Default / InfinityFree)
DB_HOST=127.0.0.1
DB_USER=root
DB_PASS=
DB_NAME=needify_db
DB_PORT=3306

# Application Environment
APP_ENV=development
APP_URL=http://localhost/Needify

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost/Needify/google-callback.php

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_REDIRECT_URI=http://localhost/Needify/facebook-callback.php
