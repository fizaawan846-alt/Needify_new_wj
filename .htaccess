# =====================================================
# NEEDIFY - ROOT APACHE CONFIGURATION
# Compatible with XAMPP and InfinityFree
# =====================================================

# Disable Directory Browsing
Options -Indexes

# Prevent Access to Sensitive and Hidden Files
<FilesMatch "^\.|\.(sql|env|log|ini|json|lock|bak|md|git|sh|yaml|yml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Protect Config Directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^config/ - [F,L]
    RewriteRule ^database/ - [F,L]
</IfModule>

# Security Headers (if headers module is loaded)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Set Default Charset
AddDefaultCharset UTF-8
